# Copie este arquivo para .env.local (desenvolvimento) e cadastre as mesmas
# variáveis em Vercel > Project > Settings > Environment Variables.

# Supabase > Project Settings > API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave "service_role" (secreta). Usada SOMENTE no servidor; nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# PRIMEIRO ACESSO da conta administradora (ADM).
# Enquanto não existir nenhum ADM, entrar com o usuário ADMIN_LOGIN e a senha
# APP_PASSWORD cria a conta ADM. Depois disso, essas duas variáveis não são mais usadas
# (a senha fica guardada criptografada no banco e pode ser trocada em "Minha senha").
ADMIN_LOGIN=admin
APP_PASSWORD=

# Segredo para assinar a sessão (mínimo 32 caracteres aleatórios).
# Gere com: openssl rand -base64 48
SESSION_SECRET=

# Fuso horário usado para "hoje", vencimentos e mês corrente
APP_TIMEZONE=America/Cuiaba
